{
  "name": "allpet-desktop",
  "version": "1.0.0",
  "description": "AllPet 跨平台桌面宠物（Electron 壳，复用 Swift AllPetCore 监控）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/haverainlilili/all-pet.git"
  },
  "author": "haverainlilili",
  "license": "MIT",
  "build": {
    "appId": "com.haverainlilili.allpet",
    "productName": "AllPet",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}
