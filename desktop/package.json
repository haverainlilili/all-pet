{
  "name": "allpet-desktop",
  "version": "1.4.1",
  "description": "AllPet 跨平台桌面宠物（Electron 壳，复用 Swift AllPetCore 监控）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "dist:local:mac": "electron-builder --mac dir --config.mac.identity=- --config.mac.hardenedRuntime=false",
    "prestart": "node scripts/package-terminal-extension.js",
    "predist": "node scripts/package-terminal-extension.js",
    "predist:dir": "node scripts/package-terminal-extension.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/haverainlilili/all-pet.git"
  },
  "author": {
    "name": "haverainlilili",
    "email": "haverainlilili@users.noreply.github.com"
  },
  "license": "MIT",
  "build": {
    "appId": "com.haverainlilili.allpet",
    "productName": "AllPet",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts/zstdcat.js",
        "to": "zstd/zstdcat.js"
      },
      {
        "from": "assets/icon.png",
        "to": "tray/icon.png"
      },
      {
        "from": "scripts/sqlite-read.js",
        "to": "sqlite/sqlite-read.js"
      },
      {
        "from": "integrations",
        "to": "terminal-integrations",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "用于确认您当前查看的终端标签页或 DSH 任务，并让对应的已完成气泡自动消失。"
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "asarUnpack": [
      "src/terminal/*.ps1",
      "src/terminal/*.py"
    ]
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}
